# Wallet seed for the CLI / integration tests (PRD §10). Real seeds live in
# .env.local / .env.preview, which are gitignored. NEVER commit or print a seed.
TACITPAY_SEED=

# Network id: undeployed | preview | preprod | mainnet (see config/networks.json)
TACITPAY_NETWORK=undeployed

# --- Web app build-time configuration (packages/ui) ---
# Bakes a deployed contract address into the bundle so the app connects without
# anyone pasting one into Settings. Optional: a judge running a local devnet can
# paste the address `yarn demo:seed` prints instead. Public values, not secrets.
VITE_TACITPAY_CONTRACT_PREVIEW=
VITE_TACITPAY_CONTRACT_LOCAL=
