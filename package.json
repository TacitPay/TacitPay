{
  "name": "tacitpay",
  "private": true,
  "version": "0.1.0",
  "description": "Private invoicing & settlement on Midnight — commitments on-chain, amounts and parties private, provable on demand.",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "contracts",
    "packages/*"
  ],
  "scripts": {
    "compile": "compact compile contracts/tacitpay.compact contracts/managed/tacitpay",
    "build": "yarn workspaces foreach -A --topological run build",
    "test": "yarn workspaces foreach -A run test",
    "test:int": "yarn workspaces foreach -A run test:int",
    "demo:seed": "yarn workspace @tacitpay/cli run build && node packages/cli/dist/index.js demo seed",
    "env:up": "./scripts/devnet.sh up",
    "env:down": "./scripts/devnet.sh down",
    "env:status": "./scripts/devnet.sh status",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "resolutions": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
