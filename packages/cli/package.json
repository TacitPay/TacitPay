{
  "name": "@tacitpay/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "tacitpay": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "yarn workspace @tacitpay/api run build && tsc -p tsconfig.build.json",
    "smoke": "yarn run build && node dist/index.js help",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@tacitpay/api": "workspace:*"
  }
}
